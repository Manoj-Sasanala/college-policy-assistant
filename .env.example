# L5 — local environment example. Copy to .env and fill locally. Never commit .env.
# Provider keys are backend-only; the frontend must never receive them.

# Optional LLM provider (leave blank for the deterministic extractive path)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# API
API_HOST=127.0.0.1
API_PORT=8000

# Retrieval (L3)
RETRIEVAL_TOP_K=3
RETRIEVAL_RELEVANCE_THRESHOLD=0.0
